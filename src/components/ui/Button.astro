---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  variant?: "primary" | "ghost";
  icon?: string;
  iconEnd?: string;
  external?: boolean;
  magnetic?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  icon,
  iconEnd,
  external = false,
  magnetic = true,
  class: className,
} = Astro.props;

const base =
  "group relative inline-flex items-center gap-2.5 overflow-hidden rounded-[var(--radius-pill)] px-7 py-3.5 text-sm font-semibold no-underline transition-[color,background-color,border-color,box-shadow] duration-300 ease-[var(--ease-out-quint)] will-change-transform";

const variants = {
  primary:
    "bg-accent-500 text-ink-950 hover:bg-accent-400 hover:shadow-[0_0_2.5rem_-0.25rem_var(--color-accent-600)]",
  ghost:
    "border border-hairline-strong text-fg hover:border-accent-500 hover:text-accent-500 hover:bg-[color-mix(in_oklab,var(--color-accent-500)_8%,transparent)]",
} as const;

const externalAttrs = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<a
  href={href}
  class:list={[base, variants[variant], className]}
  data-magnetic={magnetic ? "6" : undefined}
  {...externalAttrs}
>
  {icon && <Icon name={icon} class="size-4 shrink-0" />}
  <span class="relative z-10"><slot /></span>
  {
    iconEnd && (
      <Icon
        name={iconEnd}
        class="size-4 shrink-0 transition-transform duration-300 ease-[var(--ease-spring)] group-hover:translate-x-1"
      />
    )
  }

  {/* Barrido de luz al pasar el cursor — solo en la variante primaria */}
  {
    variant === "primary" && (
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -translate-x-full bg-[linear-gradient(110deg,transparent,rgb(255_255_255/0.45),transparent)] transition-transform duration-700 ease-[var(--ease-out-quint)] group-hover:translate-x-full motion-reduce:hidden"
      />
    )
  }
</a>
