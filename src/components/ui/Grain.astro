---
/**
 * Textura de grano.
 *
 * Los degradados oscuros muy suaves producen banding (escalones) en
 * paneles de 8 bits. Un grano al 3% de opacidad rompe esas bandas y
 * da al fondo una textura fotográfica. Es ruido generado por SVG:
 * cero peticiones de red, cero imágenes.
 */
const noise = `<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.82' numOctaves='4' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(#n)'/></svg>`;
const grainImage = `url("data:image/svg+xml,${encodeURIComponent(noise)}")`;
---

<div class="grain-layer" aria-hidden="true" style={`--grain-image:${grainImage}`}></div>

<style>
  .grain-layer {
    position: fixed;
    inset: -50%;
    z-index: 60;
    pointer-events: none;
    opacity: 0.035;
    background-image: var(--grain-image);
    animation: grain-shift 6s steps(6) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .grain-layer {
      animation: none;
      inset: 0;
    }
  }
</style>
